{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentui.dev/schemas/1/calendar.schema.json",
  "title": "calendar block",
  "description": "Day cards (almanac / date picker output). Field names yi/ji/ganZhi come from the Chinese almanac domain (宜/忌/干支); labels lets the producer localize the rendered tags.",
  "type": "object",
  "required": ["component", "days"],
  "properties": {
    "component": { "const": "calendar" },
    "title": { "type": "string", "maxLength": 61 },
    "labels": {
      "type": "object",
      "properties": {
        "yi": { "type": "string", "maxLength": 10 },
        "ji": { "type": "string", "maxLength": 10 },
        "ganZhi": { "type": "string", "maxLength": 10 }
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["date"],
        "properties": {
          "date": { "type": "string", "maxLength": 12 },
          "ganZhi": { "type": "string", "maxLength": 61 },
          "yi": { "type": "string", "maxLength": 61 },
          "ji": { "type": "string", "maxLength": 61 }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentui.dev/schemas/1/keyvalue.schema.json",
  "title": "keyvalue block",
  "type": "object",
  "required": ["component", "items"],
  "properties": {
    "component": { "const": "keyvalue" },
    "title": { "type": "string", "maxLength": 61 },
    "items": {
      "type": "array",
      "maxItems": 14,
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string", "maxLength": 121 },
          "value": { "type": "string", "maxLength": 121 }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentui.dev/schemas/1/compare.schema.json",
  "title": "compare block",
  "type": "object",
  "required": ["component", "dimensions"],
  "properties": {
    "component": { "const": "compare" },
    "title": { "type": "string", "maxLength": 61 },
    "overallScore": { "type": "number", "minimum": 0, "maximum": 100 },
    "tier": { "type": "string", "maxLength": 21 },
    "labels": {
      "type": "object",
      "properties": {
        "personA": { "type": "string", "maxLength": 25 },
        "personB": { "type": "string", "maxLength": 25 }
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["label", "score"],
        "properties": {
          "label": { "type": "string", "maxLength": 41 },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "summary": { "type": "string", "maxLength": 81 },
          "personA": { "type": "string", "maxLength": 31 },
          "personB": { "type": "string", "maxLength": 31 }
        }
      }
    }
  }
}
